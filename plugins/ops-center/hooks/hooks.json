  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*ops-center.*__search_source",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/premium-gate.sh"
          }
        ]
      }
    ]
  }
}
